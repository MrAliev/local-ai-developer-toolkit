<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately clears inherited sources. Without this, building from a machine that has
  unrelated private feeds configured can make restore depend on those feeds.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
