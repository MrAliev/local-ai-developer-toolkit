<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      The gate of #209/m5. The whole tree builds with zero warnings — that is the
      baseline — and this keeps it there: a new warning fails the build, locally and in
      CI alike, instead of scrolling past. Widening the analyzer set is a separate,
      deliberate step; this only forbids regressing below what the tree already achieves.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      The fallback for a local build, and deliberately not a number that could ever be a release.
      A real-looking version here is the trap: this said 0.1.22 through six releases, so 0.1.29
      shipped binaries that told anyone who asked that they were 0.1.22. Keeping it in step by
      hand is how it went stale, and the previous fix — "the release script passes the version" —
      left this permanently wrong instead of merely outdated.

      0.0.0-dev cannot be mistaken for a shipped build. A binary reporting it was built by
      someone's local `dotnet build`, and a release that somehow reports it is visibly broken
      rather than quietly claiming to be an older release that really existed.
    -->
    <VersionPrefix>0.0.0</VersionPrefix>
    <Version>0.0.0-dev</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <InformationalVersion>0.0.0-dev</InformationalVersion>
  </PropertyGroup>
</Project>
