<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      These tests exercise the Windows-only half of the installer: the layout lease, ACLs,
      Authenticode, the registry. The call sites are unreachable anywhere else, and building
      them as portable produced 94 CA1416 warnings saying exactly that, one per call. Naming
      the platform states what was already true instead of suppressing the analyser that
      noticed it.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LocalAi.Installer.Core\LocalAi.Installer.Core.csproj" />
    <!--
      The child process the SystemProcessRunner tests start. Referenced so its executable lands
      beside theirs; nothing in these tests calls into it as a library.
    -->
    <ProjectReference Include="..\Fixtures\ProcessFixture\ProcessFixture.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <!--
      The tests run the fixture out of its own output directory rather than a copy beside them,
      because an apphost needs its runtimeconfig.json next to it and a ProjectReference copies
      the executable without it. The reference above is what guarantees it has been built.
    -->
    <ProcessFixtureExecutable>$(MSBuildThisFileDirectory)..\Fixtures\ProcessFixture\bin\$(Configuration)\net10.0\ProcessFixture.exe</ProcessFixtureExecutable>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ProcessFixtureExecutable</_Parameter1>
      <_Parameter2>$(ProcessFixtureExecutable)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\FixturePrerequisite.cs" Link="FixturePrerequisite.cs" />
  </ItemGroup>

</Project>
