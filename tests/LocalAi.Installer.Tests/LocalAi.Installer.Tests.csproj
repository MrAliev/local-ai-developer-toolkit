<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- xUnit v3 Testing Platform tests intentionally reference the self-contained WPF executable. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LocalAi.Contracts\LocalAi.Contracts.csproj" />
    <ProjectReference Include="..\..\src\LocalAi.Installer\LocalAi.Installer.csproj" />
    <ProjectReference Include="..\..\src\LocalAi.Installer.Core\LocalAi.Installer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same installed machine the removal core tests work over, so the wizard is
         exercised against the computer those tests describe rather than a second sketch. -->
    <Compile Include="..\Shared\RemovalFixture.cs" Link="RemovalFixture.cs" />
  </ItemGroup>
</Project>
