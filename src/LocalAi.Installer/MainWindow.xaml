<Window x:Class="LocalAi.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalAi Installer"
        Width="900"
        Height="620">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="LocalAi Interactive Installer"
                   FontSize="24"
                   FontWeight="SemiBold" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding StepTitle}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />
            <TextBlock Text="{Binding StepDescription}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StepStatus}"
                       FontStyle="Italic"
                       Margin="0,12,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="PreviousButton"
                    Content="Back"
                    Width="120"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="OnPreviousClicked"
                    IsEnabled="{Binding CanMovePrevious}" />
            <Button x:Name="NextButton"
                    Content="Next"
                    Width="120"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="OnNextClicked"
                    IsEnabled="{Binding CanMoveNext}" />
            <Button x:Name="RunButton"
                    Content="Run"
                    Width="120"
                    Height="30"
                    Click="OnRunClicked"
                    Visibility="{Binding RunButtonVisibility}"
                    IsEnabled="{Binding CanRun}" />
        </StackPanel>
    </Grid>
</Window>
