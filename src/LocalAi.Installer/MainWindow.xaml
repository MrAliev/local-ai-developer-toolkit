<Window x:Class="LocalAi.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalAi.Installer.ViewModels"
        Title="LocalAi Installer"
        Width="1020"
        Height="820"
        MinWidth="980"
        MinHeight="760"
        Loaded="OnLoaded">
    <Grid Margin="16">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="15" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="FontSize" Value="14" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="LocalAi Interactive Installer"
                   FontSize="30"
                   FontWeight="SemiBold" />

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="{Binding StepTitle}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />
                <TextBlock Text="{Binding StepDescription}" FontSize="16" />
                <TextBlock Text="{Binding StepStatus}"
                           FontStyle="Italic"
                           Margin="0,12,0,8"
                           FontSize="14" />

                <StackPanel x:Name="DiagnosePanel">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Diagnose}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="{Binding Diagnose.IsSupported, StringFormat='OS supported: {0}'}" />
                </StackPanel>

                <StackPanel x:Name="DependenciesPanel">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Dependencies}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Select optional dependencies for installation (required items are pre-checked)"
                               Margin="0,0,0,10"
                               FontSize="16" />
                    <ItemsControl ItemsSource="{Binding Dependencies.Dependencies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Width="280" Text="{Binding Title}" VerticalAlignment="Center" FontSize="15" />
                                    <CheckBox Content="Install / enable"
                                              IsChecked="{Binding IsConsented}"
                                              Tag="{Binding Id}"
                                              Checked="OnDependencyConsentChanged"
                                              Unchecked="OnDependencyConsentChanged"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Required"
                                               Foreground="DarkRed"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRequired}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <CheckBox Content="Installed"
                                              IsChecked="{Binding IsInstalled}"
                                              IsEnabled="False"
                                              VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="PackagePanel">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Package}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Release tag" FontSize="16" />
                    <TextBox x:Name="PackageVersionBox"
                             Text="{Binding Package.ReleaseVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="360"
                             Height="32" />
                    <Button Content="Check compatibility and select release"
                            Click="OnPackageSelectRelease"
                            Width="360"
                            Height="34"
                            Margin="0,6,0,10" />
                    <TextBlock Text="{Binding Package.HasPackage, StringFormat='Package selected: {0}'}" />
                    <TextBlock Text="{Binding Package.IsCompatible, StringFormat='Compatible: {0}'}" />
                </StackPanel>

                <StackPanel x:Name="ModelsPanel">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Models}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <RadioButton Content="Automatic (recommended)"
                                 IsChecked="True"
                                 Checked="OnModelModeAutomatic"
                                 Margin="0,0,0,6" />
                    <RadioButton Content="Skip model setup"
                                 Checked="OnModelModeSkip"
                                 Margin="0,0,0,6" />
                    <RadioButton Content="Manual model"
                                 Checked="OnModelModeManual"
                                 Margin="0,0,0,6" />
                    <StackPanel x:Name="ManualModelPanel" Margin="20,6,0,0">
                        <TextBlock Text="Model id" />
                        <TextBox Text="{Binding Models.ManualModelId, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OnManualModelIdChanged"
                                 Width="360"
                                 Height="32" />
                        <TextBlock Text="Context window" Margin="0,8,0,0" />
                        <TextBox Text="{Binding Models.ManualContextWindow, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OnManualContextChanged"
                                 Width="160"
                                 Height="32" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="AgentsPanel">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Agents}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Choose how LocalAi integration should be applied to each client app."
                               FontSize="16"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Choose one option per client: 'Configure existing' changes current startup scripts, 'Install managed block' installs an isolated LocalAi integration layer, 'Skip' does nothing, and 'Run without agent' only installs LocalAi core without touching that client."
                               Foreground="Gray"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Agents.Agents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Width="180"
                                               Text="{Binding Agent}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <ComboBox Width="300"
                                              Height="32"
                                              Tag="{Binding Agent}"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding Choice, Mode=OneWay}"
                                              SelectionChanged="OnAgentChoiceChanged">
                                        <ComboBoxItem Tag="{x:Static vm:AgentChoice.None}">
                                            <StackPanel>
                                                <TextBlock Text="Not selected" />
                                                <TextBlock Text="Installer will keep current setup untouched for this client."
                                                           FontSize="14"
                                                           Foreground="Gray" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="{x:Static vm:AgentChoice.Skip}">
                                            <StackPanel>
                                                <TextBlock Text="Skip" />
                                                <TextBlock Text="Do not configure this agent. Existing configuration may still run."
                                                           FontSize="14"
                                                           Foreground="Gray" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="{x:Static vm:AgentChoice.ConfigureExisting}">
                                            <StackPanel>
                                                <TextBlock Text="Configure existing" />
                                                <TextBlock Text="Modify current integration files in place to point to LocalAi."
                                                           FontSize="14"
                                                           Foreground="Gray" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="{x:Static vm:AgentChoice.InstallManagedBlock}">
                                            <StackPanel>
                                                <TextBlock Text="Install managed block" />
                                                <TextBlock Text="Add LocalAi managed integration bundle and start with managed block."
                                                           FontSize="14"
                                                           Foreground="Gray" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="{x:Static vm:AgentChoice.RunWithoutAgent}">
                                            <StackPanel>
                                                <TextBlock Text="Run without agent" />
                                                <TextBlock Text="Do not configure this client; only install LocalAi core pieces."
                                                           FontSize="14"
                                                           Foreground="Gray" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                    </ComboBox>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Grid x:Name="ReviewPanel">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.ReviewApply}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel>
                        <TextBlock Text="Review" FontSize="16" FontWeight="SemiBold" />
                        <TextBox Text="{Binding ReviewText, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 IsReadOnly="True"
                                 Height="180" />
                        <CheckBox Margin="0,12,0,0"
                                  Content="I confirm these settings"
                                  IsChecked="{Binding Review.IsConfirmed}"
                                  Checked="OnReviewConfirmedChanged"
                                  Unchecked="OnReviewConfirmedChanged" />
                        <TextBlock Text="Applying actions may take some time; follow the log below."
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ProgressText}" Margin="0,12,0,8" />
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsRunning}"
                                     Maximum="100" Minimum="0" Height="16" />
                        <TextBlock Text="Execution log" Margin="0,12,0,6" FontSize="14" />
                        <TextBox Text="{Binding Finish.Progress, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 IsReadOnly="True"
                                 Height="220" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="FinishPanel">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Finish}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel>
                        <TextBlock Text="Installation complete." FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Finish.RequiresRestart, StringFormat='Restart required: {0}'}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="Summary" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <TextBox Text="{Binding FinishSummary, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 IsReadOnly="True"
                                 Height="120" />
                        <TextBlock Text="Operation log:" Margin="0,8,0,4" />
                        <TextBox Text="{Binding Finish.Progress}"
                                 TextWrapping="Wrap"
                                 IsReadOnly="True"
                                 Height="180" />
                        <TextBlock Text="{Binding RollbackResult}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="PreviousButton"
                    Content="Back"
                    Width="140"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="OnPreviousClicked"
                    IsEnabled="{Binding CanMovePrevious}"
                    Visibility="{Binding BackButtonVisibility}" />
            <Button x:Name="NextButton"
                    Content="Next"
                    Width="140"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="OnNextClicked"
                    IsEnabled="{Binding CanMoveNext}"
                    Visibility="{Binding NextButtonVisibility}" />
            <Button x:Name="RunButton"
                    Content="Run"
                    Width="140"
                    Height="36"
                    Click="OnRunClicked"
                    Visibility="{Binding RunButtonVisibility}"
                    IsEnabled="{Binding CanRun}" />
            <Button x:Name="CloseButton"
                    Content="Close"
                    Width="140"
                    Height="36"
                    Click="OnCloseClicked"
                    Visibility="{Binding CloseButtonVisibility}" />
        </StackPanel>
    </Grid>
</Window>
