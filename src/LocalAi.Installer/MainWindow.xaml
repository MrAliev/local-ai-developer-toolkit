<Window x:Class="LocalAi.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalAi.Installer.ViewModels"
        Title="{Binding WindowTitle}"
        Width="820"
        Height="620"
        MinWidth="780"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666" />
        </Style>

        <Style x:Key="WarningText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A5300" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <!-- The orientation pane: shows where the user is without any extra interaction. -->
        <DataTemplate x:Key="StepTemplate">
            <TextBlock Text="{Binding Title}" Margin="0,0,0,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#888888" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter Property="Foreground" Value="#333333" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Foreground" Value="#000000" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 220, not 180: the merged page's rail entries are longer, and
                 Russian runs 15-30% longer than English. -->
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
            <StackPanel Margin="16,20,12,16">
                <TextBlock Text="LocalAi" FontSize="15" FontWeight="Bold" />
                <!-- The one place a version is a question. Every other page states it. -->
                <TextBlock Text="{Binding VersionContext}" FontFamily="Consolas" FontSize="12"
                           Foreground="#5A5A5A" Margin="0,2,0,16" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding StepList}"
                              ItemTemplate="{StaticResource StepTemplate}" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StepDescription}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding StepStatus}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                <Border Background="#FDECEA" BorderBrush="#B3261E" BorderThickness="1" CornerRadius="3"
                        Padding="8,6" Margin="0,8,0,0"
                        Visibility="{Binding HasUnexpectedError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding UnexpectedError}" Foreground="#B3261E" />
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- System check -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Diagnose}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Margin="0,4,0,0"
                                    Visibility="{Binding Diagnose.IsChecking, Converter={StaticResource BoolToVisibility}}">
                            <!-- The lead above already says what is happening; this is the
                                 detail line under the spinner. -->
                            <TextBlock Text="Starting winget, git and ollama…"
                                       Style="{StaticResource Muted}" Margin="0,0,0,10" />
                            <ProgressBar IsIndeterminate="True" Height="4" Width="280" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Diagnose.Checks}"
                                      Visibility="{Binding Diagnose.HasResults, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1A7F37" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:CheckStatus.Warning}">
                                                            <Setter Property="Foreground" Value="#8A5300" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:CheckStatus.Missing}">
                                                            <Setter Property="Foreground" Value="#8A5300" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:CheckStatus.Blocking}">
                                                            <Setter Property="Foreground" Value="#B42318" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Diagnose.UnsupportedReason}"
                                   Style="{StaticResource WarningText}"
                                   Margin="0,10,0,0" />
                        <!-- A previous run that was killed mid-install left effects nobody
                             wrote down anywhere else; this is where they get offered back. -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding HasInterruptedRunNotice, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Interrupted previous run" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding InterruptedRunNotice, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160"
                                     VerticalScrollBarVisibility="Auto" Background="#FFF8F0" />
                            <Button Content="Roll back previous run"
                                    Command="{Binding RollbackPreviousRunCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4"
                                    Visibility="{Binding HasInterruptedRun, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Prerequisites -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Dependencies}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ItemsControl ItemsSource="{Binding Dependencies.Dependencies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsConsented}"
                                                  IsEnabled="{Binding IsInstallable}"
                                                  Tag="{Binding Id}"
                                                  Checked="OnDependencyConsentChanged"
                                                  Unchecked="OnDependencyConsentChanged"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,8,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock>
                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding StateText, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding RequirementText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="No automated installer is available; install it yourself."
                                                       FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstallable}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- LocalAi package -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Package}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Version to install" />
                        <TextBox Text="{Binding Package.ReleaseVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="280" Height="24" HorizontalAlignment="Left" Margin="0,4,0,2" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Leave this at latest to install whatever is newest when you press the button on the last page. Type a version number instead to pin one." />
                        <TextBlock Text="Install from a folder" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,4"
                                   Text="A folder holding release-manifest.json, release-manifest.sig and localai-package.zip. Leave empty to install from GitHub. The manifest is verified against the key built into this installer either way; models still come from the Ollama registry." />
                        <TextBox Text="{Binding Package.SourceFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="480" Height="24" HorizontalAlignment="Left" Margin="0,0,0,8" />
                        <Button Content="Check again" Width="140" Height="26" HorizontalAlignment="Left"
                                IsEnabled="{Binding Package.CanCheck}"
                                Click="OnPackageCheckRelease" />
                        <TextBlock Text="{Binding Package.StatusText}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                    </StackPanel>

                    <!-- Models and memory: the rule that decides what fits, above the list
                         that follows from it. These were two pages, and the recompute the rule
                         triggers landed on a page the reader had already left (#257). -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Models}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Video memory" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Residency.AdapterFound}"
                                   Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"
                                   Visibility="{Binding Residency.HasAdapterFound, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Residency.AdapterHint}"
                                   Style="{StaticResource WarningText}" Margin="0,0,0,8"
                                   Visibility="{Binding Residency.HasAdapterHint, Converter={StaticResource BoolToVisibility}}" />
                        <RadioButton GroupName="Residency" IsChecked="{Binding Residency.IsRequireFullVram, Mode=TwoWay}" Margin="0,0,0,4">
                            <TextBlock Text="Require the whole model in video memory (recommended)" />
                        </RadioButton>
                        <TextBlock Text="Refuses to run a model that does not fit. Fastest, and the only rule that never degrades an answer."
                                   Style="{StaticResource Muted}" FontSize="11" Margin="20,0,0,6"
                                   Visibility="{Binding Residency.IsRequireFullVram, Converter={StaticResource BoolToVisibility}}" />
                        <RadioButton GroupName="Residency" IsChecked="{Binding Residency.IsAllowPartialOffload, Mode=TwoWay}" Margin="0,0,0,4">
                            <TextBlock Text="Allow part of the model in system memory &#8212; slower" />
                        </RadioButton>
                        <TextBlock Text="Needs an adapter that holds at least part of the model."
                                   Style="{StaticResource Muted}" FontSize="11" Margin="20,0,0,6"
                                   Visibility="{Binding Residency.IsAllowPartialOffload, Converter={StaticResource BoolToVisibility}}" />
                        <RadioButton GroupName="Residency" IsChecked="{Binding Residency.IsAllowCpu, Mode=TwoWay}" Margin="0,0,0,4">
                            <TextBlock Text="Allow running on the processor &#8212; much slower" />
                        </RadioButton>
                        <TextBlock Text="Works without a usable adapter."
                                   Style="{StaticResource Muted}" FontSize="11" Margin="20,0,0,6"
                                   Visibility="{Binding Residency.IsAllowCpu, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Residency.Warning}" Margin="0,4,0,0"
                                   Style="{StaticResource WarningText}"
                                   Visibility="{Binding Residency.HasWarning, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="Local models" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <!-- The anchor: it restates the rule inside the group the rule governs,
                             so the dependency stays legible once the radios have scrolled away,
                             and its count moves the moment the rule does. -->
                        <TextBlock Text="{Binding Models.RuleSummary}"
                                   Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8" />
                        <RadioButton GroupName="ModelMode" Content="Choose automatically for this computer"
                                     IsChecked="{Binding Models.IsAutomatic, Mode=TwoWay}" Margin="0,0,0,4" />
                        <StackPanel Margin="20,0,0,10"
                                    Visibility="{Binding Models.IsAutomatic, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Models.AutomaticSummary}"
                                       Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Models.AutomaticSelection}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <RadioButton GroupName="ModelMode" Content="Choose exactly"
                                     IsChecked="{Binding Models.IsChooseExact, Mode=TwoWay}" Margin="0,0,0,4" />
                        <StackPanel Margin="20,0,0,10"
                                    Visibility="{Binding Models.IsChooseExact, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Model" />
                            <ComboBox ItemsSource="{Binding Models.CatalogModels}"
                                      SelectedItem="{Binding Models.SelectedModel, Mode=TwoWay}"
                                      DisplayMemberPath="Tag"
                                      MaxWidth="320" HorizontalAlignment="Left" Height="24" Margin="0,4,0,8" />
                            <TextBlock Text="Context size" />
                            <ComboBox ItemsSource="{Binding Models.Contexts}"
                                      SelectedItem="{Binding Models.SelectedContext, Mode=TwoWay}"
                                      MaxWidth="160" HorizontalAlignment="Left" Height="24" Margin="0,4,0,6" />
                            <TextBlock Text="Only the sizes this model permits are offered. A smaller context needs less video memory."
                                       Style="{StaticResource Muted}" FontSize="11" />
                        </StackPanel>
                        <RadioButton GroupName="ModelMode" Content="Skip model setup"
                                     IsChecked="{Binding Models.IsSkip, Mode=TwoWay}" Margin="0,0,0,4" />
                        <TextBlock Text="Nothing is downloaded now. Models can be set up later."
                                   Style="{StaticResource Muted}" FontSize="11" Margin="20,0,0,0"
                                   Visibility="{Binding Models.IsSkip, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>


                    <!-- Client apps -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Agents}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ItemsControl ItemsSource="{Binding Agents.Agents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock>
                                            <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" (" /><Run Text="{Binding DetectionText, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                        <ComboBox Width="380" Height="24" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                  Tag="{Binding Agent}"
                                                  ItemsSource="{Binding DataContext.Agents.Choices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Choice, Mode=OneWay}"
                                                  SelectionChanged="OnAgentChoiceChanged" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Confirm: a milestone page, summary and consent only. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Confirm}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBox Text="{Binding ReviewText, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" Height="200"
                                 VerticalScrollBarVisibility="Auto" Background="#FAFAFA" />
                        <!-- Two questions, two buttons, in review-box row order: the release
                             is the first row, the settings are the rest. -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Choose a release…"
                                    Command="{Binding RevealReleaseCommand}"
                                    Padding="12,4" Margin="0,0,8,0"
                                    Visibility="{Binding IsReleaseFolded, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Change settings…"
                                    Command="{Binding RevealSettingsCommand}"
                                    Padding="12,4"
                                    Visibility="{Binding AreSettingsFolded, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <CheckBox Content="{Binding ConsentText}"
                                  Margin="0,12,0,0"
                                  IsChecked="{Binding Review.IsConfirmed, Mode=TwoWay}"
                                  Checked="OnReviewConfirmedChanged"
                                  Unchecked="OnReviewConfirmedChanged" />
                        <!-- Opt-in, off unless ticked, with what it does stated beside it
                             rather than in a document nobody opens. -->
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3"
                                Padding="10,8" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="After this installation" FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <CheckBox Content="After it is installed, let LocalAi look up whether a newer release exists"
                                          IsChecked="{Binding Review.EnableUpdateCheck, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="A newer version is then mentioned in localai doctor and in the index status your assistant reads. Nothing pops up, and nothing installs itself." />
                                <TextBlock Text="{Binding Review.UpdateCheckDisclosure, Mode=OneTime}"
                                           Style="{StaticResource Muted}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Progress -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Progress}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding ProgressText}" Margin="0,0,0,8" />
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="16" />
                        <TextBlock Text="Log" Margin="0,14,0,4" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Finish.Progress, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" Height="200"
                                 VerticalScrollBarVisibility="Auto" Background="#FAFAFA" />
                    </StackPanel>

                    <!-- Finish -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Finish}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBox Text="{Binding FinishSummary, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" Height="110"
                                 VerticalScrollBarVisibility="Auto" Background="#FAFAFA" />
                        <TextBlock Text="Log" Margin="0,12,0,4" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Finish.Progress, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" Height="180"
                                 VerticalScrollBarVisibility="Auto" Background="#FAFAFA" />
                        <!-- Only after a failed or cancelled run with reversible effects:
                             rollback is a recovery, not an uninstaller for a good run. -->
                        <Button Content="Roll back changes"
                                Command="{Binding RollbackCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,4"
                                Visibility="{Binding CanRollback, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Visibility="{Binding Finish.HasRollbackReport, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Rollback" Margin="0,12,0,4" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Finish.RollbackReport, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap" Height="140"
                                     VerticalScrollBarVisibility="Auto" Background="#FAFAFA" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Navigation stays in place for the whole wizard; only availability changes. -->
            <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Back" Style="{StaticResource NavButton}"
                            Command="{Binding BackCommand}" />
                    <Button Content="Next" Style="{StaticResource NavButton}"
                            Command="{Binding NextCommand}"
                            Visibility="{Binding IsNextVisible, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{Binding ActionText}" Style="{StaticResource NavButton}" IsDefault="True"
                            Command="{Binding InstallCommand}"
                            Visibility="{Binding IsInstallVisible, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{Binding CancelButtonText}" Style="{StaticResource NavButton}" IsCancel="True"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
