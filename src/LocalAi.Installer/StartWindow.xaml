<Window x:Class="LocalAi.Installer.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalAi.Installer.ViewModels"
        Background="{DynamicResource WindowFill}"
        Title="LocalAi"
        Width="640"
        Height="640"
        MinWidth="600"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Style.Triggers>
                <!-- Recessed rather than greyed: on a dark page a slightly different grey is
                     not a difference, and the button being disabled is the only other cue. -->
                <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource WindowFill}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThemeSegment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background"
                                        Value="{DynamicResource SelectionFill}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Segment" Property="Background"
                                        Value="{DynamicResource Surface}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LanguageLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,6,0,0" />
            </StackPanel>
            <!-- Autonyms, never translated and never a flag: a flag is a country, and a Russian
                 speaker outside Russia is not served by one. The active language is plain rather
                 than greyed — grey reads as unavailable, which is backwards. -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="12,2,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="English" FontWeight="SemiBold"
                           Visibility="{Binding IsEnglish, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="English" Style="{StaticResource LanguageLink}"
                        AutomationProperties.Name="Switch the installer to English"
                        Tag="English" Click="OnChooseLanguage"
                        Visibility="{Binding IsRussian, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="·" Foreground="{DynamicResource TextMuted}" Margin="8,0,8,0" />
                <TextBlock Text="Русский" FontWeight="SemiBold"
                           Visibility="{Binding IsRussian, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Русский" Style="{StaticResource LanguageLink}"
                        AutomationProperties.Name="Переключить установщик на русский"
                        Tag="Russian" Click="OnChooseLanguage"
                        Visibility="{Binding IsEnglish, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <!-- Three segments rather than a light/dark pair: "System" is not a third colour
                 scheme, it is the answer somebody already gave Windows, and dropping it would
                 make the installer stop listening the moment they touched this. -->
            <Border Margin="0,8,0,0" HorizontalAlignment="Right" CornerRadius="3"
                    BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                    Background="{DynamicResource ControlFill}" SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource ThemeSegment}"
                                 Content="{x:Static vm:PageLabels.ThemeSystem}"
                                 Tag="System" Checked="OnChooseTheme"
                                 IsChecked="{Binding IsSystemTheme, Mode=OneWay}" />
                    <Border Width="1" Background="{DynamicResource ControlBorder}" />
                    <RadioButton Style="{StaticResource ThemeSegment}"
                                 Content="{x:Static vm:PageLabels.ThemeLight}"
                                 Tag="Light" Checked="OnChooseTheme"
                                 IsChecked="{Binding IsLightTheme, Mode=OneWay}" />
                    <Border Width="1" Background="{DynamicResource ControlBorder}" />
                    <RadioButton Style="{StaticResource ThemeSegment}"
                                 Content="{x:Static vm:PageLabels.ThemeDark}"
                                 Tag="Dark" Checked="OnChooseTheme"
                                 IsChecked="{Binding IsDarkTheme, Mode=OneWay}" />
                </StackPanel>
            </Border>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <!-- WPF has no elevation; a lighter top edge is the only
                                         way a card can say "raised", and in light there is
                                         nothing to lighten so the token matches the border. -->
                                    <Border Height="1" Background="{DynamicResource RaisedEdge}"
                                            Margin="-12,-10,-12,10" />
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                               Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                    <!-- Why an option is out of reach, said in place. A greyed
                                         button with no explanation is a worse answer than none. -->
                                    <Border Margin="0,8,0,0" Padding="8,5" CornerRadius="3"
                                            Background="{DynamicResource WarnFill}"
                                            BorderBrush="{DynamicResource WarnLine}"
                                            BorderThickness="1"
                                            Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding UnavailableReason}"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource WarnText}" />
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding DataContext.ChooseText, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="88" Height="28"
                                        VerticalAlignment="Top"
                                        IsEnabled="{Binding IsAvailable}"
                                        Tag="{Binding Choice}"
                                        Click="OnChoose" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"
                Padding="0,10,0,0" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding CloseText}" MinWidth="96" Height="28" IsCancel="True" Click="OnClose" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
