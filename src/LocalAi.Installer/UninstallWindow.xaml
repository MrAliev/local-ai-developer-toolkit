<Window x:Class="LocalAi.Installer.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalAi.Installer.ViewModels"
        Background="{DynamicResource WindowFill}"
        Foreground="{DynamicResource TextPrimary}"
        Title="{x:Static vm:PageLabels.RemoveLocalAi}"
        Width="760"
        Height="560"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <DataTemplate x:Key="StepTemplate">
            <TextBlock Text="{Binding Title}" Margin="0,0,0,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 200, matching the installation wizard: Russian rail entries run 15-30%
                 longer, and the window is 760 wide, so the room costs nothing. -->
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource RailFill}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
            <StackPanel Margin="16,20,12,16">
                <TextBlock Text="{x:Static vm:PageLabels.RemoveLocalAi}" FontSize="15" FontWeight="Bold" Margin="0,0,0,16" />
                <ItemsControl ItemsSource="{Binding StepList}"
                              ItemTemplate="{StaticResource StepTemplate}" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StepDescription}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding StepStatus}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                <Border Background="{DynamicResource ErrFill}" BorderBrush="{DynamicResource ErrLine}" BorderThickness="1" CornerRadius="3"
                        Padding="8,6" Margin="0,8,0,0"
                        Visibility="{Binding HasUnexpectedError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding UnexpectedError}" Foreground="{DynamicResource ErrText}" />
                </Border>
                <!-- Another wizard is running, or there is nothing here to remove. Either way
                     this run does not start. -->
                <Border Background="{DynamicResource WarnFill}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="3"
                        Padding="8,6" Margin="0,8,0,0"
                        Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding BlockingNotice}" Foreground="{DynamicResource WarnText}" />
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- What to remove -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:UninstallPage.Choose}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{x:Static vm:PageLabels.StartFrom}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="Preset" Margin="0,0,0,8"
                                                 Tag="{Binding Preset}"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Checked="OnPresetChecked">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Static vm:PageLabels.WhatGoes}" FontWeight="SemiBold" Margin="0,10,0,6" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Top" Margin="0,2,8,0" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DecisionText}" Style="{StaticResource Muted}"
                                                           FontStyle="Italic" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Static vm:PageLabels.ConnectedRepositories}" FontWeight="SemiBold" Margin="0,10,0,6" />
                        <ItemsControl ItemsSource="{Binding Repositories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding CanChoose}"
                                                  VerticalAlignment="Top" Margin="0,2,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding CommonDirectory}" />
                                        <TextBlock Grid.Column="2" Text="{Binding StateText}"
                                                   Style="{StaticResource Muted}" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The loudest thing on the page, and the only choice a preset never
                             makes for you. -->
                        <Border Background="{DynamicResource WarnFill}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1"
                                CornerRadius="3" Padding="8,6" Margin="0,10,0,0">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding RemoveSigningKeys}">
                                    <TextBlock Text="{Binding SigningKeysTitle}" FontWeight="SemiBold" />
                                </CheckBox>
                                <TextBlock Text="{Binding SigningKeysWarning}" Foreground="{DynamicResource WarnText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Confirm -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:UninstallPage.Confirm}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- Above the list, not after it: the box scrolls and is 300 high, so
                             anything below it sits between the list and the consent tick and
                             competes with it. A sentence that frames a list goes before it. -->
                        <TextBlock Text="{Binding KeepNotice}" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding HasKeepNotice, Converter={StaticResource BoolToVisibility}}" />
                        <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="NoWrap" Height="300"
                                 FontFamily="Consolas"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}" />
                        <CheckBox Margin="0,12,0,0"
                                  IsChecked="{Binding IsConfirmed}"
                                  Content="{x:Static vm:PageLabels.RemovalConsent}" />
                    </StackPanel>

                    <!-- Progress -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:UninstallPage.Progress}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
                        <TextBlock Text="{Binding ProgressText}" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Finish -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:UninstallPage.Finish}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBox Text="{Binding Summary, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" Height="90"
                                 VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}" />
                        <TextBlock Text="{x:Static vm:PageLabels.Report}" Margin="0,12,0,4" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Report, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" Height="220"
                                 VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}" />
                        <!-- The install half of a clean reinstall, offered only once the
                             removal half has finished and only when it succeeded. -->
                        <Button Content="{x:Static vm:PageLabels.ContinueToInstall}"
                                Command="{Binding ContinueToInstallCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,4"
                                Visibility="{Binding CanContinueToInstall, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static vm:PageLabels.Back}" Style="{StaticResource NavButton}"
                            Command="{Binding BackCommand}" />
                    <Button Content="{x:Static vm:PageLabels.Next}" Style="{StaticResource NavButton}"
                            Command="{Binding NextCommand}"
                            Visibility="{Binding IsNextVisible, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{x:Static vm:PageLabels.Uninstall}" Style="{StaticResource NavButton}" IsDefault="True"
                            Command="{Binding UninstallCommand}"
                            Visibility="{Binding IsUninstallVisible, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{Binding CancelButtonText}" Style="{StaticResource NavButton}" IsCancel="True"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
