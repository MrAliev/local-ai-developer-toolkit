<!--
    The dark palette. Same key set as Light.xaml, and deliberately not an inversion of it.

    Three things do not simply invert. The advisory strips keep their hue and swap their weight:
    the fill darkens and desaturates while the text lightens and saturates, because a pale amber
    panel on a dark page outranks the primary button and turns an advisory into an alarm. The
    review box, which in light states itself by being 2% darker than the page, is lighter than
    the window here — two percent lighter would be invisible — and gains a border light does not
    draw. And the accent splits: no single hex is legible as 12px text on #1F1F1F and also
    carries white at 4.5:1.

    Ratios against the surface each colour sits on: TextPrimary 14.6:1, TextSecondary 8.6:1,
    TextMuted 5.3:1, Accent 6.9:1, white on AccentFill 4.6:1, Success 8.9:1, WarnText 9.3:1,
    ErrText 8.5:1. TextDisabled is 2.7:1 on purpose.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The rail stays darker than the content, as in light. -->
    <SolidColorBrush x:Key="WindowFill" Color="#1F1F1F" />
    <SolidColorBrush x:Key="RailFill" Color="#171717" />
    <SolidColorBrush x:Key="Surface" Color="#272727" />
    <SolidColorBrush x:Key="ControlFill" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ControlBorder" Color="#4A4A4A" />
    <SolidColorBrush x:Key="Divider" Color="#383838" />

    <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TextSecondary" Color="#C0C0C0" />
    <SolidColorBrush x:Key="TextMuted" Color="#9A9A9A" />
    <SolidColorBrush x:Key="TextDisabled" Color="#6E6E6E" />

    <SolidColorBrush x:Key="Accent" Color="#4CA0E0" />
    <SolidColorBrush x:Key="AccentFill" Color="#2D7FD3" />
    <SolidColorBrush x:Key="Success" Color="#5CC95C" />

    <SolidColorBrush x:Key="WarnText" Color="#F0B858" />
    <SolidColorBrush x:Key="WarnFill" Color="#3A2E18" />
    <SolidColorBrush x:Key="WarnLine" Color="#8A6A22" />
    <SolidColorBrush x:Key="ErrText" Color="#FF9A92" />
    <SolidColorBrush x:Key="ErrFill" Color="#3A1E1C" />
    <SolidColorBrush x:Key="ErrLine" Color="#8C3A34" />

    <SolidColorBrush x:Key="FocusRing" Color="#7FC0F0" />
    <SolidColorBrush x:Key="SelectionFill" Color="#264F78" />
    <SolidColorBrush x:Key="ScrollTrack" Color="#1F1F1F" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#5E5E5E" />

    <!-- WPF has no elevation, and a lighter top edge is the only way a card can say "raised".
         Light needs none: on white there is nothing to lighten. -->
    <SolidColorBrush x:Key="RaisedEdge" Color="#3A3A3A" />
</ResourceDictionary>
