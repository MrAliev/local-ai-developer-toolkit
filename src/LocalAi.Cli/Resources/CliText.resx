  </data>
  <data name="UpdateAvailable" xml:space="preserve">
    <value>{0} is available; this installation is {1}. {2}</value>
  </data>
  <data name="UpdateCheckDisabled" xml:space="preserve">
    <value>check disabled; run `localai policy set --update-check on` to look for releases</value>
  </data>
  <data name="UpdateIncomparable" xml:space="preserve">
    <value>latest verified release is {0}; this installation does not record which release it came from, so the two cannot be compared. The next install or update records it.</value>
  </data>
  <data name="UpdateNeverChecked" xml:space="preserve">
    <value>unknown; nothing has been checked yet</value>
  </data>
  <data name="UpdateUnknownUnavailable" xml:space="preserve">
    <value>unknown; the last check produced nothing to believe (tried {0} UTC)</value>
  </data>
  <data name="UpdateUpToDate" xml:space="preserve">
    <value>up to date at {0} (checked {1} UTC)</value>
  </data>
  <data name="VersionComplete" xml:space="preserve">
    <value>{0}, all {1} binaries present</value>
  </data>
  <data name="VersionDirectoryMissing" xml:space="preserve">
    <value>The pointer names {0} and that directory does not exist.</value>
  </data>
  <data name="VersionFilesMissing" xml:space="preserve">
    <value>{0} is missing: {1}</value>
  </data>
  <data name="VersionNoPointer" xml:space="preserve">
    <value>No current.json under {0}. Nothing is installed here.</value>
  </data>
  <data name="VersionPointerEmpty" xml:space="preserve">
    <value>current.json names no version.</value>
  </data>
  <data name="VersionPointerUnreadable" xml:space="preserve">
    <value>current.json cannot be read: {0}</value>
    <comment>0 is a .NET runtime message and arrives in whatever language the framework speaks.</comment>
  </data>
</root>
