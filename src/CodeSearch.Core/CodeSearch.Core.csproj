<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Required by the LibraryImport source generator used for the working-set trim. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalAi.Broker.Client\LocalAi.Broker.Client.csproj" />
    <ProjectReference Include="..\LocalAi.Contracts\LocalAi.Contracts.csproj" />
    <ProjectReference Include="..\LocalAi.Repository\LocalAi.Repository.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0"
                      GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48"
                      ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.11" />
  </ItemGroup>

  <!--
    Roslyn deliberately publishes its out-of-process MSBuild hosts as loose content.
    LocalAi ships CodeSearch as a single executable, so keep a trusted copy inside the
    bundle and materialize it into a private temporary directory only while a semantic
    workspace is alive.
  -->
  <ItemGroup>
    <EmbeddedResource Include="$(PkgMicrosoft_CodeAnalysis_Workspaces_MSBuild)/contentFiles/any/any/BuildHost-netcore/**/*">
      <LogicalName>LocalAi.RoslynBuildHost/BuildHost-netcore/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PkgMicrosoft_CodeAnalysis_Workspaces_MSBuild)/contentFiles/any/any/BuildHost-net472/**/*">
      <LogicalName>LocalAi.RoslynBuildHost/BuildHost-net472/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
